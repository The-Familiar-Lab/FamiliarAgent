#!/bin/sh
set -eu

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in
  /*) ;;
  *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

# Follow symlinks so `/usr/local/bin/paseo` resolves back into the app bundle.
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

MACOS_DIR="${RESOURCES_DIR}/../MacOS"
MACOS_HELPER_EXECUTABLE="${RESOURCES_DIR}/../Frameworks/FamiliarAgent Helper.app/Contents/MacOS/FamiliarAgent Helper"

# macOS CLI invocations must enter Electron through the agent Helper. Launching
# the main APPL executable here makes later daemon supervision inherit app UI
# lifecycle behavior.
if [ -d "${MACOS_DIR}" ]; then
  if [ ! -x "${MACOS_HELPER_EXECUTABLE}" ]; then
    echo "Bundled FamiliarAgent Helper executable not found at ${MACOS_HELPER_EXECUTABLE}" >&2
    exit 1
  fi
  APP_EXECUTABLE="${MACOS_HELPER_EXECUTABLE}"
elif [ -x "${RESOURCES_DIR}/../FamiliarAgent.bin" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../FamiliarAgent.bin"
elif [ -x "${RESOURCES_DIR}/../FamiliarAgent" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../FamiliarAgent"
else
  echo "Bundled FamiliarAgent executable not found relative to ${RESOURCES_DIR}" >&2
  exit 1
fi

if [ -z "${PASEO_HOME:-}" ]; then
  PASEO_HOME="$HOME/.local/share/familiaragent/state"
  # Until the upgraded app performs its directory relocation, use the existing
  # daemon. This prevents CLI-first upgrades from creating a second data store.
  if [ ! -d "$PASEO_HOME" ]; then
    if [ -d "${MACOS_DIR}" ]; then LEGACY_HOME="$HOME/Library/Application Support/FamiliarAgent/daemon"; else LEGACY_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/FamiliarAgent/daemon"; fi
    if [ -d "$LEGACY_HOME" ]; then PASEO_HOME="$LEGACY_HOME"; fi
  fi
  export PASEO_HOME
fi

RUNNER_PATH="${RESOURCES_DIR}/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js"
CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar/node_modules/@getpaseo/cli/dist/index.js"

exec env ELECTRON_RUN_AS_NODE=1 PASEO_NODE_ENV=production PASEO_CLI="${SCRIPT_PATH}" "${APP_EXECUTABLE}" --disable-warning=DEP0040 "${RUNNER_PATH}" node-script "${CLI_ENTRYPOINT}" "$@"
